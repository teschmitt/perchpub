# flavor_name     = "b3-8"
# image_name      = "Debian 12"
# domain          = "perchpub.net"
# repo_url        = "https://codeberg.org/perchpub/perchpub.git"
# volume_size_gb  = 40
# bucket_name     = "perchpub-bucket"
