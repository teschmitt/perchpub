# Playwright e2e runner for the SvelteKit frontend. Builds the SSR app so the
# Playwright `webServer` can boot it (`node build`); tests run against it inside
# the compose stack (docker-compose.override.yml `playwright` service).
# Keep the tag aligned with the @playwright/test version in package.json.
FROM mcr.microsoft.com/playwright:v1.63.0-noble
WORKDIR /app
ENV CI=true
COPY package*.json /app/
RUN npm ci
COPY ./ /app/
RUN npm run build
