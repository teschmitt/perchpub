# Copy to .env (or .env.dev / .env.prod) and fill in real values.
# Anything labelled "changethis" must be replaced before the app will start
# outside of ENVIRONMENT=local. Generate fresh secrets with:
#   SECRET_KEY                 → python -c "import secrets; print(secrets.token_urlsafe(32))"
#   ENROLLMENT_HMAC_KEY_HEX    → python -c "import secrets; print(secrets.token_bytes(32).hex())"
#   FIRST_SUPERUSER_PASSWORD   → python -c "import secrets; print(secrets.token_urlsafe(24))"

# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost

# Let's Encrypt registration email — used by the production Traefik edge's
# ACME resolver (docker-compose.prod.yml). Unused in local dev (no proxy).
EMAIL=changethis

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173

# Public station-facing edge origin — the :443 enrollment origin a station
# (Raspberry Pi) talks to, e.g. https://api.perchpub.net. Emitted to stations as
# `perchpub_url` in the enrollment QR and the /enrollment/create response, so a
# station enrolls with zero pre-configuration (it derives its :8443 upload
# endpoint from this and validates the edge TLS against public trust). MUST be
# the canonical public origin whose edge cert SAN matches — never an internal
# host/container/IP — and distinct from FRONTEND_HOST (the dashboard origin).
# Absolute https:// origin, no path, no trailing slash. Required outside
# ENVIRONMENT=local.
STATION_EDGE_URL=https://api.localhost

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="PerchPub"
STACK_NAME=perchpub

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Device enrollment HMAC key — must be 64 hex characters (32 bytes).
ENROLLMENT_HMAC_KEY_HEX=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND="perchpub-api"
DOCKER_IMAGE_FRONTEND="perchpub-frontend"

PERCHPUB_VOLUME="/mnt/perchpub-vol"

# Object storage (Garage / S3-compatible)
GARAGE_BUCKET_NAME="perchpub-bucket"
GARAGE_ENDPOINT="blob-storage:3900"
GARAGE_KEY_ID=changethis
GARAGE_SECRET=changethis
# SigV4 region for the S3 endpoint. "garage" for self-hosted Garage / Minio;
# set to the bucket's lowercase region for a cloud provider (OVH GRA => "gra").
GARAGE_REGION=garage
# Whether the S3 endpoint is HTTPS. True for cloud providers; False for a
# plain-HTTP local Minio.
GARAGE_USE_TLS=True

# step-ca device-enrollment provisioner
CA_NAME="PerchPubCA"
STEP_CA_URL="https://step-ca:9000"
STEP_CA_PROVISIONER_NAME="backend-device-enrollment"
STEP_CA_PROVISIONER_KID=changethis
STEP_CA_JWK_PATH="/home/step/backend-provisioner.pub"
STEP_CA_ADMIN_PASSWORD=changethis

# Optional debug-router unlock key for /api/v1/private/* (leave empty to disable).
DEBUG_KEY=

# Classification model in object storage
CLASSIFICATION_MODEL_OBJECT_NAME="birdiary-v0.1/classify.tflite"
CLASSIFICATION_LABELS_OBJECT_NAME="birdiary-v0.1/labels.txt"

# Huey / Redis
HUEY_CLIENT_NAME="perchpub"
HUEY_REDIS_HOST="redis"
HUEY_REDIS_PORT=6379
