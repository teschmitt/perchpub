# Integration-test stack env. Checked in deliberately — every value here
# is for the ephemeral test compose project and never touches a real
# service. Regenerate freely (`secrets.token_urlsafe(32)`) on rotation.
#
# Used both at compose-parse time (`--env-file .env.test`) and sourced by
# `backend/scripts/integration-test.sh` so the host-side pytest process
# sees the same creds and reaches services on the localhost-mapped ports.

COMPOSE_PROJECT_NAME=perchpub-test

DOMAIN=test.localhost
FRONTEND_HOST=http://localhost:5174
ENVIRONMENT=local

PROJECT_NAME=perchpub-test
STACK_NAME=perchpub-test

DOCKER_IMAGE_BACKEND=perchpub-api
DOCKER_IMAGE_FRONTEND=perchpub-frontend

BACKEND_CORS_ORIGINS=http://localhost

SECRET_KEY=NF1RKDTIOO2LhBZqNmrmKMyo-AyNP4XIlrhzPDx_bm0
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=4-T3st-Pa55w0rd
ENROLLMENT_HMAC_KEY_HEX=cd71dde048ae64d8d27ed90c6bd91f60dd56d7bcf09b148e07ee9e88810a0345

# Postgres: host-side reaches via localhost:5433; compose services see `db:5432`
# (POSTGRES_SERVER overridden in docker-compose.yml's prestart/backend/worker).
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=app_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test-pgpw

# Object storage: in-stack minio replaces Hetzner. Host-side reaches via
# localhost:9100; compose services see `minio:9000` (overridden per service
# in docker-compose.test.yml).
GARAGE_BUCKET_NAME=perchpub-test-bucket
GARAGE_ENDPOINT=localhost:9100
GARAGE_KEY_ID=testaccesskey
GARAGE_SECRET=testsecretkeysecret
GARAGE_USE_TLS=False
GARAGE_REGION=garage

CLASSIFICATION_MODEL_OBJECT_NAME=test/classify.tflite
CLASSIFICATION_LABELS_OBJECT_NAME=test/labels.txt

# Huey/Redis: host-side reaches via localhost:6380; compose services see `redis:6379`.
HUEY_CLIENT_NAME=perchpub-test
HUEY_REDIS_HOST=localhost
HUEY_REDIS_PORT=6380

# step-ca host-side: scripts/integration-test.sh exports STEP_CA_JWK_PATH
# and STEP_CA_ROOT_CERT_PATH after extracting them via `docker compose cp`,
# overriding the container paths below. STEP_CA_URL points at the host-
# mapped port so the test process (running on the host) can reach step-ca.
CA_NAME=PerchPubTestCA
STEP_CA_URL=https://localhost:9001
STEP_CA_PROVISIONER_NAME=backend-device-enrollment
STEP_CA_ADMIN_PASSWORD=test-step-ca-pw
STEP_CA_JWK_PATH=/home/step-ca/backend-provisioner.jwk

SENTRY_DSN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
EMAILS_FROM_EMAIL=noreply@example.com
